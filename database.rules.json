{
  "rules": {
    "regia": {
      "$stanza": {
        "stato": {
          ".read": true,
          ".write": "auth != null && auth.token.docente === true && auth.token.stanza === $stanza"
        },
        "docente": {
          ".read": true,
          ".write": "auth != null && auth.token.docente === true && auth.token.stanza === $stanza"
        },
        "postazioni": {
          ".read": "auth != null && auth.token.docente === true && auth.token.stanza === $stanza",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (auth.token.docente === true && auth.token.stanza === $stanza))",
            ".validate": "newData.hasChildren(['nome', 'spia']) && newData.child('nome').isString() && newData.child('nome').val().length <= 24 && newData.child('spia').isString() && newData.child('spia').val().length <= 8"
          }
        }
      }
    }
  }
}
